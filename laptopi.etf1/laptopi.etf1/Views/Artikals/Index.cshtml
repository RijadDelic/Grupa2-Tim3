@model IEnumerable<laptopi.etf1.Models.Artikal>

@{
    ViewData["Title"] = "Artikli";
    Layout = "_Layout";
}

<div class="lp-index-wrapper">

    <a asp-controller="Home" asp-action="Index" class="lp-back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6" /></svg>
        Nazad na početnu
    </a>

    <div class="lp-page-hero">
        <div class="lp-hero-left">
            <h2 class="lp-index-title">Moji oglasi</h2>
            <p class="lp-index-count">@Model.Count() oglasa ukupno</p>
        </div>
        <a asp-action="Create" class="lp-btn-add">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Dodaj oglas
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="lp-empty">
            <div class="lp-empty-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="2" />
                    <path d="M8 18v2M16 18v2M6 20h12" />
                </svg>
            </div>
            <p class="lp-empty-title">Nema oglasa</p>
            <p class="lp-empty-sub">Dodajte prvi laptop!</p>
            <a asp-action="Create" class="lp-btn-add" style="margin-top:20px;">+ Dodaj oglas</a>
        </div>
    }
    else
    {
        <div class="lp-grid">
            @foreach (var item in Model)
            {
                <div class="lp-card">
                    <div class="lp-card-img">
                        @if (!string.IsNullOrEmpty(item.slikaPath))
                        {
                            <img src="@item.slikaPath" alt="@item.naziv" />
                        }
                        else
                        {
                            <div class="lp-card-img-placeholder">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="2" y="6" width="20" height="12" rx="2" />
                                    <path d="M8 18v2M16 18v2M6 20h12" />
                                    <path d="M9 10h6M9 13h4" />
                                </svg>
                            </div>
                        }
                        <div class="lp-card-badges">
                            <span class="lp-badge @(item.stranje.ToString() == "Novo" ? "lp-badge-novo" : "lp-badge-polovno")">
                                @item.stranje
                            </span>
                            <span class="lp-badge lp-badge-kat">@item.kategorija</span>
                        </div>
                        @if (item.prosjecnaOcjena > 0)
                        {
                            <span class="lp-ocjena-overlay">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                @item.prosjecnaOcjena.ToString("0.0")
                            </span>
                        }
                    </div>

                    <div class="lp-card-body">
                        <h3 class="lp-card-naziv">@item.naziv</h3>
                        <p class="lp-card-opis">
                            @(item.opis != null && item.opis.Length > 90 ? item.opis.Substring(0, 90) + "..." : item.opis)
                        </p>

                        <div class="lp-card-footer">
                            <span class="lp-cijena">
                                @if (item.cijena > 0)
                                {
                                    @item.cijena.ToString("0.00")
                                    <text> KM</text>
                                }
                                else
                                {
                                    <span class="lp-cijena-none">Cijena na upit</span>
                                }
                            </span>
                            <div class="lp-card-actions">
                                <a asp-action="Details" asp-route-artikalid="@item.ArtikalId" class="lp-action-btn lp-action-primary">Detalji</a>
                                <a asp-action="Edit" asp-route-artikalid="@item.ArtikalId" class="lp-action-btn lp-action-ghost" title="Uredi">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                </a>
                                @if (item.tipTransakcije.ToString() == "Iznajmljivanje")
                                {
                                    <a asp-controller="Kalendar" asp-action="Upravljaj" asp-route-artikalId="@item.ArtikalId"
                                       class="lp-action-btn lp-action-ghost" title="Kalendar">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2" />
                                            <line x1="16" y1="2" x2="16" y2="6" />
                                            <line x1="8" y1="2" x2="8" y2="6" />
                                            <line x1="3" y1="10" x2="21" y2="10" />
                                        </svg>
                                    </a>
                                }
                                <button type="button" onclick="otvoriModal(@item.ArtikalId, '@Html.Raw(item.naziv.Replace("'", "\\'"))')" class="lp-action-btn lp-action-danger" title="Obriši">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Delete Modal -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:14px; padding:32px; max-width:380px; width:90%; text-align:center; box-shadow: 0 8px 32px rgba(0,0,0,0.12);">
        <div style="width:56px; height:56px; background:#fde8e8; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 18px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e05252" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6" />
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                <path d="M10 11v6M14 11v6" />
                <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
            </svg>
        </div>
        <h5 style="font-size:18px; font-weight:600; color:#1e2a38; margin:0 0 10px;">Obriši oglas</h5>
        <p style="font-size:14px; color:#888; margin:0 0 26px; line-height:1.5;">
            Jeste li sigurni da želite obrisati<br><strong id="modalNaziv" style="color:#1e2a38;"></strong>?<br>
            <span style="font-size:12px; color:#bbb;">Ova radnja se ne može poništiti.</span>
        </p>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button type="button" onclick="zatvoriModal()" style="padding:10px 24px; border-radius:8px; border:1px solid #e2e2dc; background:#fff; font-size:14px; cursor:pointer; font-weight:500; color:#555; font-family:inherit;">
                Odustani
            </button>
            <form id="deleteForm" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" style="padding:10px 24px; border-radius:8px; border:none; background:#e05252; color:#fff; font-size:14px; cursor:pointer; font-weight:600; font-family:inherit;">
                    Obriši
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .lp-index-wrapper {
        max-width: 1140px;
        margin: 0 auto;
        padding: 32px 24px 80px;
    }

    .lp-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 13px;
        color: #999;
        text-decoration: none;
        margin-bottom: 24px;
        padding: 5px 10px 5px 6px;
        border-radius: 6px;
        transition: background 0.15s, color 0.15s;
    }

        .lp-back-btn:hover {
            background: #1e2a38;
            color: #fff;
        }

    .lp-page-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid #eee;
    }

    .lp-index-title {
        font-size: 24px;
        font-weight: 700;
        color: #1e2a38;
        margin: 0;
        letter-spacing: -0.4px;
    }

    .lp-index-count {
        margin: 5px 0 0;
        font-size: 13px;
        color: #aaa;
    }

    .lp-btn-add {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #1e2a38;
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s;
    }

        .lp-btn-add:hover {
            background: #2d3f55;
            color: #fff;
        }

    .lp-empty {
        text-align: center;
        padding: 100px 20px;
    }

    .lp-empty-icon {
        width: 72px;
        height: 72px;
        background: #f0f4f8;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: #c5cfd8;
    }

    .lp-empty-title {
        font-size: 18px;
        font-weight: 600;
        color: #555;
        margin: 0 0 6px;
    }

    .lp-empty-sub {
        font-size: 14px;
        color: #bbb;
        margin: 0;
    }

    .lp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 22px;
    }

    .lp-card {
        background: #fff;
        border: 1px solid #e8e8e3;
        border-radius: 14px;
        overflow: hidden;
        transition: box-shadow 0.2s, transform 0.2s;
    }

        .lp-card:hover {
            box-shadow: 0 6px 24px rgba(30,42,56,0.10);
            transform: translateY(-3px);
        }

    .lp-card-img {
        position: relative;
        height: 190px;
        background: #f0f4f8;
        overflow: hidden;
    }

        .lp-card-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .lp-card-img-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c5cfd8;
    }

    .lp-card-badges {
        position: absolute;
        top: 10px;
        left: 10px;
        display: flex;
        gap: 5px;
    }

    .lp-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.03em;
    }

    .lp-badge-novo {
        background: #e6f4ea;
        color: #2d7a3f;
    }

    .lp-badge-polovno {
        background: #fff3e0;
        color: #b45309;
    }

    .lp-badge-kat {
        background: rgba(30,42,56,0.75);
        color: #fff;
    }

    .lp-ocjena-overlay {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0,0,0,0.55);
        color: #f59e0b;
        font-size: 12px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .lp-card-body {
        padding: 16px 18px 18px;
    }

    .lp-card-naziv {
        font-size: 16px;
        font-weight: 600;
        color: #1e2a38;
        margin: 0 0 8px;
        letter-spacing: -0.2px;
    }

    .lp-card-opis {
        font-size: 13px;
        color: #888;
        margin: 0 0 16px;
        line-height: 1.55;
    }

    .lp-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid #f0f0ea;
    }

    .lp-cijena {
        font-size: 17px;
        font-weight: 700;
        color: #1e2a38;
        letter-spacing: -0.3px;
    }

    .lp-cijena-none {
        font-size: 13px;
        font-weight: 400;
        color: #aaa;
    }

    .lp-card-actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .lp-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 14px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.15s, border-color 0.15s;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .lp-action-primary {
        background: #1e2a38;
        color: #fff;
    }

        .lp-action-primary:hover {
            background: #2d3f55;
            color: #fff;
        }

    .lp-action-ghost {
        border-color: #e2e2dc;
        color: #555;
        padding: 6px 10px;
        background: none;
    }

        .lp-action-ghost:hover {
            background: #f0f4f8;
            color: #1e2a38;
            border-color: #1e2a38;
        }

    .lp-action-danger {
        border-color: #fde8e8;
        color: #e05252;
        padding: 6px 10px;
        background: none;
    }

        .lp-action-danger:hover {
            background: #fde8e8;
        }

    @@media (max-width: 640px) {
        .lp-grid {
            grid-template-columns: 1fr;
        }

        .lp-page-hero {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
        }
    }
</style>

<script>
    function otvoriModal(id, naziv) {
        document.getElementById('modalNaziv').textContent = naziv;
        document.getElementById('deleteForm').setAttribute('action', '/Artikals/Delete/' + id);
        document.getElementById('deleteModal').style.display = 'flex';
    }

    function zatvoriModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }

    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) zatvoriModal();
    });
</script>
